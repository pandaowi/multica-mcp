# =================================================================
# Multica MCP Server Environment Configuration Template
# Copy this file to .env or .env.production and customize variables
# =================================================================

# Node Environment ('development', 'production', 'test')
NODE_ENV=production

# Server Transport Configuration
# Options: 'stdio' (for desktop IDEs), 'sse' (for HTTP streaming server)
MULTICA_MCP_TRANSPORT=stdio

# HTTP / SSE Server Host and Port (only relevant when transport is 'sse')
PORT=3000
HOST=0.0.0.0

# -----------------------------------------------------------------
# Multica Platform Connection Settings
# -----------------------------------------------------------------
# Target Multica server endpoint (API gateway / platform URL)
MULTICA_SERVER_URL=http://127.0.0.1:8080

# Multica API Authentication Token (Keep Secret!)
MULTICA_API_KEY=your_multica_api_key_here

# Default Multica Workspace UUID context
MULTICA_WORKSPACE_ID=your_workspace_uuid_here

# Optional: Default Target Project UUID context
MULTICA_PROJECT_ID=

# -----------------------------------------------------------------
# Security & Mutation Governance Settings
# -----------------------------------------------------------------
# Operational mode:
# - 'read_only': Resource reads and get/list tools only (zero side-effects)
# - 'standard': Standard developer workflows (issues, comments, checkout)
# - 'admin': Full access including agent creation, squad rosters, and mutations
MULTICA_MCP_MODE=standard

# Agent Mention Trigger Guard
# When set to false, mentions like mention://agent/<id> are formatted as inert text
# to prevent accidental runs. Set to true to permit triggering agent runs.
MULTICA_MCP_ALLOW_AGENT_TRIGGERS=false

# Secret Redaction Enforcement
# When true, all custom_env and sensitive credentials in responses are redacted.
MULTICA_MCP_REDACT_SECRETS=true

# -----------------------------------------------------------------
# Performance, Rate Limiting & Timeouts
# -----------------------------------------------------------------
# Request timeout to Multica server in milliseconds
MULTICA_API_TIMEOUT_MS=10000

# Connection max retries
MULTICA_API_MAX_RETRIES=3

# Rate limit: Max requests per window per IP
MULTICA_MCP_RATE_LIMIT_MAX=100
MULTICA_MCP_RATE_LIMIT_WINDOW_MS=60000

# -----------------------------------------------------------------
# Logging & Observability
# -----------------------------------------------------------------
# Log level: 'trace', 'debug', 'info', 'warn', 'error', 'silent'
MULTICA_MCP_LOG_LEVEL=info

# Structured JSON logging format (true in production, false for human-readable dev logs)
MULTICA_MCP_JSON_LOGS=true
